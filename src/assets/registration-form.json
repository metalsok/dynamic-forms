{
  "description": "User registration form",
  "controls": {
    "username": {
      "controlType": "input",
      "type": "text",
      "label": "Username",
      "value": null,
      "validators": {
        "required": true,
        "minLength": 3
      }
    },
    "email": {
      "controlType": "input",
      "type": "email",
      "label": "Email Address",
      "value": null,
      "validators": {
        "required": true,
        "email": true
      }
    },

    "role": {
      "controlType": "select",
      "label": "User Role",
      "value": null,
      "validators": {
        "required": true
      },
      "options": [
        {
          "label": "Admin",
          "value": "admin"
        },
        {
          "label": "Editor",
          "value": "editor"
        },
        {
          "label": "Viewer",
          "value": "viewer"
        }
      ]
    },
    "socialMediaAccounts": {
      "controlType": "group",
      "label": "Links to Social Profiles",
      "controls": {
        "youtube": {
          "controlType": "input",
          "type": "text",
          "label": "Youtube",
          "value": null
        },
        "instagram": {
          "controlType": "input",
          "type": "text",
          "label": "Instagram",
          "value": null
        },
        "twitter": {
          "controlType": "input",
          "type": "text",
          "label": "Twitter",
          "value": null
        }
      }
    },
    "terms": {
      "controlType": "checkbox",
      "label": "Terms and Conditions",
      "value": false,
      "validators": {
        "requiredTrue": true
      }
    }
  }
}
